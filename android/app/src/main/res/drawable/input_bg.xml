<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dastyabSurfaceElevated" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="?attr/dastyabCardBorderFocus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dastyabOutputBg" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/dastyabCardBorder" />
        </shape>
    </item>
</selector>
