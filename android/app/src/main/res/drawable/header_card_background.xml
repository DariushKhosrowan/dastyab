<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="?attr/dastyabHeaderStart"
                android:centerColor="?attr/dastyabHeaderMid"
                android:endColor="?attr/dastyabHeaderEnd" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="?attr/dastyabCardBorderAccent" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="?attr/dastyabSpecularHighlight" />
        </shape>
    </item>
</layer-list>
