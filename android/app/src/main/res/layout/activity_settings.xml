<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/dastyabBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/header_card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/icon_badge_bg"
                android:padding="10dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_profiles"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/dastyabAccent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_appearance_title"
                    android:textSize="12sp"
                    android:textColor="?attr/dastyabTextSecondary"
                    android:paddingTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Appearance: Theme & Language Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/tvCurrentTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnChooseTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_choose_theme"
                style="@style/DastyabButtonPrimary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvCurrentLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnChooseLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_choose_language"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Logging Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_log_level"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerLogLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <CheckBox
                android:id="@+id/cbAutoUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_auto_update"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Storage & Maintenance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_logs"
                style="@style/DastyabButton"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnClearCrashLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_crash_logs"
                style="@style/DastyabButton"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_history"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Updates & Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <Button
                android:id="@+id/btnForceRedownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_force_redownload"
                style="@style/DastyabButtonPrimary"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSettingsAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_about"
                style="@style/DastyabButton" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?attr/dastyabChipText"
            android:paddingTop="14dp"
            android:paddingStart="4dp" />

    </LinearLayout>
</ScrollView>
