<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:paddingBottom="12dp" />

        <!-- Log level -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_log_level"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerLogLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <!-- Auto-update toggle -->
        <CheckBox
            android:id="@+id/cbAutoUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_update"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_logs"
            style="@style/DastyabButton" />

        <Button
            android:id="@+id/btnClearCrashLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_crash_logs"
            style="@style/DastyabButton" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_history"
            style="@style/DastyabButton" />

        <Button
            android:id="@+id/btnForceRedownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_force_redownload"
            style="@style/DastyabButton" />

        <Button
            android:id="@+id/btnSettingsAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_about"
            style="@style/DastyabButton" />

        <TextView
            android:id="@+id/tvSettingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/colorTextSecondary"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
