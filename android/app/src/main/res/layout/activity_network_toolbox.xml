<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dastyabBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_card_background"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_subtitle"
                android:textSize="13sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="4dp" />

            <ProgressBar
                android:id="@+id/toolboxProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                android:paddingTop="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Target Host / Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_target_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/etToolboxHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/toolbox_host_hint"
                android:text="aistudio.google.com"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:inputType="textUri" />

            <!-- Quick Host Presets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/btnPresetAiStudio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_preset_aistudio"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnPresetFlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_preset_flow"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnPresetGithub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_preset_github"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnPresetTelegram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_preset_telegram"
                    style="@style/DastyabChip" />
            </LinearLayout>

            <!-- Tool Buttons Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnToolExitTrace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_btn_exit_ip"
                    style="@style/DastyabButtonPrimary" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnToolDnsPoison"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_btn_dns_poison"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnToolTlsInspect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_btn_tls_inspect"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnToolTcpPing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_btn_tcp_ping"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToolBase64"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_btn_base64"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnToolCidrGen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolbox_btn_cidr_gen"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToolUriInspect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/toolbox_btn_uri_inspect"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Output Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvToolboxOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_output_empty"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:textIsSelectable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <Button
            android:id="@+id/btnToolboxBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            style="@style/DastyabButton" />
    </LinearLayout>
</ScrollView>
