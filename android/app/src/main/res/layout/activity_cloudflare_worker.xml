<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dastyabBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_card_background"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/icon_badge_bg"
                    android:padding="9dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_action_deploy"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cf_studio_title"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="?attr/dastyabAccent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cf_studio_subtitle"
                        android:textSize="12sp"
                        android:textColor="?attr/dastyabTextSecondary"
                        android:paddingTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp">

                <Spinner
                    android:id="@+id/spStudioProfile"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnStudioNewProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_btn_new_profile"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnStudioRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_btn_refresh"
                    style="@style/DastyabChip" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/cfProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="?attr/dastyabAccent"
                android:progressBackgroundTint="?attr/dastyabDivider"
                android:visibility="gone"
                android:paddingTop="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 1. Profile, API Token & Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_section_token"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvTokenStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_token_status_empty"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/etTokenLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/cf_hint_token_label"
                    android:text="default"
                    android:textSize="13sp"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnPasteToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_btn_paste_token"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <EditText
                android:id="@+id/etApiToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cf_hint_api_token"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:background="@drawable/input_bg"
                android:padding="11dp"
                android:inputType="textNoSuggestions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/btnSaveVerifyToken"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="@string/cf_btn_save_verify"
                    style="@style/DastyabButtonPrimary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnListAccounts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_accounts"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnCfVerifyOnly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_verify"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnCfTokenList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_tokens"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnCfZones"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_zones"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnCfAnalytics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_analytics"
                    style="@style/DastyabChip" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 2. Deploy Worker or Bring Existing Worker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_section_worker"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/tab_container_bg"
                android:padding="4dp"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnModeDeployNew"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="@string/cf_btn_mode_deploy"
                    style="@style/DastyabTabActive" />

                <Button
                    android:id="@+id/btnModeExistingWorker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="@string/cf_btn_mode_existing"
                    style="@style/DastyabTabInactive" />
            </LinearLayout>

            <!-- Deploy New Worker Panel -->
            <LinearLayout
                android:id="@+id/panelDeployNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:id="@+id/llAccountChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etDeployAccountId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cf_hint_account_id"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />

                <EditText
                    android:id="@+id/etDeployWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/cf_hint_worker_name"
                    android:textSize="13sp"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tab_container_bg"
                    android:padding="4dp"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnPresetStandard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:text="standard"
                        style="@style/DastyabTabActive" />

                    <Button
                        android:id="@+id/btnPresetGaming"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:text="gaming"
                        style="@style/DastyabTabInactive" />

                    <Button
                        android:id="@+id/btnPresetMaxCompat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:text="max-compat"
                        style="@style/DastyabTabInactive" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPresetDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/dastyabTextSecondary"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp" />

                <Button
                    android:id="@+id/btnDeployWorker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_btn_deploy_worker"
                    style="@style/DastyabButtonPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <Button
                        android:id="@+id/btnMultiWorkerDeploy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cf_btn_multi_worker"
                        style="@style/DastyabButton" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnRotateWorkerSig"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cf_btn_multi_status"
                        style="@style/DastyabButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- Use Existing Worker Panel -->
            <LinearLayout
                android:id="@+id/panelExistingWorker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etExistingWorkerHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cf_hint_existing_host"
                    android:textSize="13sp"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <EditText
                        android:id="@+id/etExistingWorkerUuid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/cf_hint_existing_uuid"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/dastyabTextPrimary"
                        android:textColorHint="?attr/dastyabTextSecondary"
                        android:background="@drawable/input_bg"
                        android:padding="11dp"
                        android:inputType="textNoSuggestions" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <Button
                        android:id="@+id/btnGenUuid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cf_btn_gen_uuid"
                        style="@style/DastyabButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <EditText
                        android:id="@+id/etExistingWorkerPath"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="/"
                        android:hint="@string/cf_hint_ws_path"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/dastyabTextPrimary"
                        android:textColorHint="?attr/dastyabTextSecondary"
                        android:background="@drawable/input_bg"
                        android:padding="11dp"
                        android:inputType="textNoSuggestions" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <EditText
                        android:id="@+id/etExistingWorkerPort"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="443"
                        android:hint="@string/cf_hint_port"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/dastyabTextPrimary"
                        android:textColorHint="?attr/dastyabTextSecondary"
                        android:background="@drawable/input_bg"
                        android:padding="11dp"
                        android:inputType="number" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBuildFromExistingWorker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_btn_build_existing"
                    style="@style/DastyabButtonPrimary" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 3. Clean IP Discovery & Pool -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_section_cleanip"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvCleanIpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_cleanip_status_zero"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFindCleanRust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_find_rust"
                    style="@style/DastyabButtonPrimary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnScoutCleanDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_scout_device"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <EditText
                    android:id="@+id/etCustomCleanIp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/cf_hint_custom_cleanip"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnAddCustomCleanIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_btn_add_cleanip"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/llCleanIpChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBatchCleanConfigs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_apply_top5"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnListCleanIpsCli"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_cleanip_ledger"
                    style="@style/DastyabButton" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 4. Config Editor, Clean-IP Patcher & Export -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_section_editor"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvEditorBaseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_editor_status_empty"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/llHistoryConfigChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/btnPasteVlessConfig"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_paste_vless"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnLoadActiveVpnConfig"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_active_vpn"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnResetWorkerHost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_restore_host"
                    style="@style/DastyabChip" />
            </LinearLayout>

            <!-- Server Address / Clean IP + Port -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEditAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/cf_hint_edit_address"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <EditText
                    android:id="@+id/etEditPort"
                    android:layout_width="86dp"
                    android:layout_height="wrap_content"
                    android:text="443"
                    android:hint="@string/cf_hint_port"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="number" />
            </LinearLayout>

            <EditText
                android:id="@+id/etEditSni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/cf_hint_edit_sni"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:background="@drawable/input_bg"
                android:padding="11dp"
                android:inputType="textNoSuggestions" />

            <EditText
                android:id="@+id/etEditHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/cf_hint_edit_host"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:background="@drawable/input_bg"
                android:padding="11dp"
                android:inputType="textNoSuggestions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/etEditPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/"
                    android:hint="@string/cf_hint_ws_path"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <EditText
                    android:id="@+id/etEditFp"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="chrome"
                    android:hint="@string/cf_hint_fp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions" />
            </LinearLayout>

            <EditText
                android:id="@+id/etEditUuid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/cf_hint_uuid"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:background="@drawable/input_bg"
                android:padding="11dp"
                android:inputType="textNoSuggestions" />

            <EditText
                android:id="@+id/etEditRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/cf_hint_remark"
                android:textSize="13sp"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary"
                android:background="@drawable/input_bg"
                android:padding="11dp"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/btnTestHandshake"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_test_handshake"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnSaveActivateVpn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/cf_btn_save_activate"
                    style="@style/DastyabButtonPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnStudioQr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_qr_code"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnRefreshExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_render_export"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <!-- Export Format Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/tab_container_bg"
                android:padding="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnFmtLink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="vless://"
                    style="@style/DastyabTabActive" />

                <Button
                    android:id="@+id/btnFmtV2rayN"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="v2rayN"
                    style="@style/DastyabTabInactive" />

                <Button
                    android:id="@+id/btnFmtSingBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="sing-box"
                    style="@style/DastyabTabInactive" />

                <Button
                    android:id="@+id/btnFmtClash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="Clash"
                    style="@style/DastyabTabInactive" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExportPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:maxLines="14"
                android:text="@string/cf_export_preview_hint"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:background="?attr/dastyabOutputBg"
                android:padding="12dp"
                android:textIsSelectable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnCopyExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copy"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnShareExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_share"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnCliExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cf_btn_rust_export"
                    style="@style/DastyabButton" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 5. Linux Power CLI & Live Console -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cf_section_linux"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="10dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:id="@+id/llLinuxCliChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/etStudioCliArgs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/cf_hint_cli_args"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/dastyabTextPrimary"
                    android:textColorHint="?attr/dastyabTextSecondary"
                    android:background="@drawable/input_bg"
                    android:padding="11dp"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionSend" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnStudioRunCli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_run"
                    style="@style/DastyabButtonPrimary" />

                <Button
                    android:id="@+id/btnStudioCancelCli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/cf_btn_stop"
                    android:visibility="gone"
                    style="@style/DastyabButton" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStudioConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:text="@string/cf_console_empty"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="?attr/dastyabTextPrimary"
                android:background="?attr/dastyabOutputBg"
                android:padding="12dp"
                android:textIsSelectable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnStudioClearConsole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_clear"
                    style="@style/DastyabButton" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnStudioCopyConsole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copy"
                    style="@style/DastyabButton" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <Button
            android:id="@+id/btnStudioBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browser_btn_back"
            style="@style/DastyabButton" />
    </LinearLayout>
</ScrollView>
