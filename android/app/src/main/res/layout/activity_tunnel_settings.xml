<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dastyabBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tunnel_settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/dastyabAccent"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tunnel_settings_subtitle"
            android:textSize="13sp"
            android:textColor="?attr/dastyabTextSecondary"
            android:paddingBottom="16dp" />

        <!-- Routing Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_mode_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerTunnelMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvTunnelModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="8dp" />

            <CheckBox
                android:id="@+id/cbBypassLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_bypass_lan"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="10dp" />

            <CheckBox
                android:id="@+id/cbAutoVpnGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_auto_vpn_google"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="6dp" />

            <CheckBox
                android:id="@+id/cbWatchdogEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_watchdog_enabled"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="6dp" />

            <CheckBox
                android:id="@+id/cbAutoConnectBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_auto_connect_boot"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/btnDomainDnsRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tunnel_btn_domain_rules"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- AI Studio & Flow Geo-Bypass & Local Proxy Port Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_proxy_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_proxy_mode_label"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerGoogleAccessMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvGoogleAccessModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingTop="6dp"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_upstream_scheme_label"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerUpstreamScheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 1-Tap Local Proxy Presets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnPresetV2rayHttp"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="@string/tunnel_preset_v2ray_http"
                    android:textSize="10sp"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnPresetV2raySocks"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="@string/tunnel_preset_v2ray_socks"
                    android:textSize="10sp"
                    style="@style/DastyabChip" />

                <Button
                    android:id="@+id/btnPresetNekobox"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="@string/tunnel_preset_nekobox"
                    android:textSize="10sp"
                    style="@style/DastyabChip" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_upstream_host_label"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etUpstreamHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_upstream_port_label"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etUpstreamPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_local_bridge_port_label"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etLocalBridgePort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary"
                android:layout_marginBottom="6dp" />

            <CheckBox
                android:id="@+id/cbAutoStartBridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_auto_start_bridge"
                android:textColor="?attr/dastyabTextPrimary"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btnToggleLocalBridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_btn_bridge_toggle_start"
                style="@style/DastyabButton" />

            <Button
                android:id="@+id/btnCopyV2rayNgSocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tunnel_btn_copy_v2rayng"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Split Tunnel Apps Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_split_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvSplitSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_split_none"
                android:textSize="13sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btnPickApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_pick_apps_btn"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- VLESS Upstream Endpoint Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_vless_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/etVlessUri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/tunnel_vless_hint"
                android:inputType="textUri|textMultiLine"
                android:minLines="2"
                android:maxLines="4"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary"
                android:textColorHint="?attr/dastyabTextSecondary" />

            <TextView
                android:id="@+id/tvVlessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_vless_none"
                android:textSize="12sp"
                android:textColor="?attr/dastyabChipText"
                android:paddingTop="8dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnPasteVless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_paste_vless"
                style="@style/DastyabButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- DNS & MTU Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_network_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/dastyabAccent"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_dns_primary"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etDnsPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_dns_secondary"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etDnsSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tunnel_mtu_label"
                android:textSize="12sp"
                android:textColor="?attr/dastyabTextSecondary"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etMtu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:textColor="?attr/dastyabTextPrimary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <Button
            android:id="@+id/btnSaveTunnel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tunnel_save_apply"
            style="@style/DastyabButtonPrimary" />

    </LinearLayout>
</ScrollView>
