<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/dastyabBackground">

    <!-- Top Royal Gold Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_card_background"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnBrowserClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="14sp"
            android:padding="0dp"
            style="@style/DastyabChip" />

        <com.dastyab.app.StatusHaloView
            android:id="@+id/browserVpnDot"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvBrowserTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/simple_card_aistudio"
            android:textColor="?attr/dastyabAccent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnBrowserProxyMode"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="@string/browser_btn_proxy"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DastyabChip" />

        <Button
            android:id="@+id/btnBrowserAutoFix"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="@string/browser_btn_autofix"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DastyabChip" />

        <Button
            android:id="@+id/btnBrowserOpenChrome"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/browser_btn_chrome"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DastyabChip" />
    </LinearLayout>

    <!-- Live Geo & Route Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/dastyabSurfaceElevated"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tvBrowserRouteStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/browser_route_checking"
            android:textSize="11sp"
            android:textColor="?attr/dastyabTextSecondary"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnBrowserGeoCheck"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:text="@string/browser_btn_geocheck"
            android:textSize="10sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DastyabChip" />

        <Button
            android:id="@+id/btnBrowserSwitchSite"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:text="@string/browser_btn_switch_site"
            android:textSize="10sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/DastyabChip" />
    </LinearLayout>

    <!-- Navigation Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/dastyabSurface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnBrowserBack"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/browser_btn_back"
            android:textSize="11sp"
            style="@style/DastyabChip" />

        <Button
            android:id="@+id/btnBrowserForward"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/browser_btn_forward"
            android:textSize="11sp"
            style="@style/DastyabChip" />

        <Button
            android:id="@+id/btnBrowserReload"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/browser_btn_reload"
            android:textSize="11sp"
            style="@style/DastyabChip" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/browserProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="?attr/dastyabAccent"
        android:progressBackgroundTint="?attr/dastyabDivider"
        android:visibility="gone" />

    <WebView
        android:id="@+id/browserWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
